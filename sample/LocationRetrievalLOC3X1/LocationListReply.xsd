<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:bons0="http://ei/location/location"
	targetNamespace="http://ei/location/location_list_reply"
	xmlns:bons1="http://ei/core/status_informationx1">
	<xsd:import schemaLocation="../Schemas/StatusInformationX1.xsd"
		namespace="http://ei/core/status_informationx1">
	</xsd:import>
	<xsd:import namespace="http://ei/location/location"
		schemaLocation="../Schemas/Location.xsd">
	</xsd:import>
	<xsd:complexType name="LocationListReply">
		<xsd:sequence>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="Location" type="bons0:Location">
			</xsd:element>
			<xsd:element minOccurs="0" name="StatusInformation"
				type="bons1:StatusInformation">
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
