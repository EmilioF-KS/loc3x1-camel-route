<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://ei/core/premiumx7"
	xmlns:bons0="http://ei/core/customization">
	<xsd:import schemaLocation="Customization.xsd"
		namespace="http://ei/core/customization">
	</xsd:import>
	<xsd:complexType name="Premium">
		<xsd:sequence>
			<xsd:element minOccurs="0" name="PremiumTypeReferenceCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a code that identifies a specific premium type.
</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="PremiumName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a name that identifies a specific premium type.  </xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="PremiumAmount"
				type="xsd:decimal">
				<xsd:annotation>
          <xsd:documentation>This element contains the amount of money to be paid to the  insurance company in exchange for the protection provided in the contract.
</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="PremiumCurrencyCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a code which identifies the currency of the premium amount.
The E1T01030 Corporate table contains the valid values for this element in the "ISO_CURNCY_C" column.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="PremiumRate"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the Rate that will be applied to determine the Premium Amount.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="FlatPremiumIndicator"
				type="xsd:boolean">
				<xsd:annotation>
          <xsd:documentation>This element specifies if the premium amount is an established value and requires no premium calculation.
</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="PremiumCurrencyExchangeRate" type="xsd:decimal">
				<xsd:annotation>
          <xsd:documentation>This element is used in a calculation to convert premium amounts from one currency to another currency.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="OriginalCurrencyCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element is a code for the original currency prior to translation.  
The E1T00121 Corporate Table contains valid values for this element in the "ORIG_CUR_C" column. 
</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="PremiumCurrencyUsageName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the details on the usage of this currency of the Premium.    This can be used to help indentify which is the local, reported, or  accounting currency.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="PremiumPercent"
				type="xsd:decimal">
				<xsd:annotation>
          <xsd:documentation>This element contains a percent of the total premium.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="PremiumAdjustmentTypeCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>&lt;p&gt;
    This element contains a code that identifies that type of Premium Adjustment.
&lt;/p&gt;
&lt;p&gt;
    Valid values include 'C'-Credit and 'A'-Adjustment.
&lt;/p&gt;</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="StatisticalCode"
				type="xsd:string"><xsd:annotation><xsd:documentation>&lt;br /&gt;
&lt;p&gt;
    This element contains a code that identifies&amp;nbsp;a monetary value, such as a premium or surcharge, as it is known for
    statistical reporting.
&lt;/p&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="PremiumBasisAmount"
				type="xsd:decimal"><xsd:annotation><xsd:documentation>&lt;BR&gt;
&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;SPAN style='FONT-SIZE: 10pt; FONT-FAMILY: &quot;Arial&quot;,&quot;sans-serif&quot;'&gt;This element contains the amount&amp;nbsp;used as&amp;nbsp;the basis of the premium; it is used to calculate other financial amounts.&lt;?xml:namespace prefix = &quot;o&quot; ns = &quot;urn:schemas-microsoft-com:office:office&quot; /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;br/&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" maxOccurs="unbounded"
				name="Customization" type="bons0:Customization">
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>