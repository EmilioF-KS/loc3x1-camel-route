<?xml version="1.0" encoding="UTF-8"?><xsd:schema targetNamespace="http://ei/core/sponsorx3" xmlns:bons1="http://ei/core/addressx5" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:import namespace="http://ei/core/addressx5" schemaLocation="AddressX5.xsd">
	</xsd:import>
	<xsd:complexType name="Sponsor">
		<xsd:sequence>
			<xsd:element minOccurs="0" name="Address" type="bons1:Address">
			</xsd:element>
			<xsd:element minOccurs="0" name="SponsorName" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the name of the sponsor.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="PhoneNumber" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a person's phone number.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="FaxNumber" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a person's fax number.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="EmailAddress" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a person's e-mail address.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>