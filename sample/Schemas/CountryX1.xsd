<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://ei/core/countryx1"
	xmlns:bons0="http://ei/core/territory"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:import namespace="http://ei/core/territory"
		schemaLocation="Territory.xsd">
	</xsd:import>
	<xsd:complexType name="Country">
		<xsd:sequence>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="Territory" type="bons0:Territory">
			</xsd:element>
			<xsd:element minOccurs="0" name="CountryCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element is a code for a country, nation or political state.
The E1T00101 Corporate Table contains valid values for this element in the "CNTRY_C" column.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="CountryAbbreviation"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element is the abbreviation for a country, nation or political state.
The E1T00101 Corporate Table contains valid values for this element in the "CNTRY_AB" column. </xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="CountryName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element is the name for a country, nation or political state.
The E1T00101 Corporate Table contains valid values for this element in the "CNTRY_NA" column. </xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="CountryDescription"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element is the description for a country, nation or political state.
The E1T00101 Corporate Table contains valid values for this element in the "CNTRY_DE" column. </xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ISOCountryCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element is the abbreviation used by the International Standards Organization (ISO) that identifies a country, nation or political state.
The E1T00101 Corporate Table contains valid values for this element in the "ISO_CNTRY_C" column. </xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ISOCountryDescription"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element is the description used by the International Standards Organization (ISO) that identifies a country, nation or political state.
The E1T00101 Corporate Table contains valid values for this element in the "ISO_CNTRY_DE" column. </xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ConvertedISOCountryCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element is a legacy Chubb code for a country, nation or political state.
The E1T00101 Corporate Table contains valid values for this element in the "CONV_ISO_CNTRY_C" column.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ISOCountry3PositionCode"
				type="xsd:string"><xsd:annotation><xsd:documentation>This element is the 3 position code used by the International Standards Organization (ISO) which identifies a country, nation or political state.
The E1T00101 Corporate Table contains valid values for this element in the &quot;ISO_CNTRY_3_POS_C&quot; column. </xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ISO31661Numeric3Code"
				type="xsd:string"><xsd:annotation><xsd:documentation>This element contains the 3 position numeric code used by the International Standards Organization (ISO) and defined by the United Nations Statistic Division M49 countries.</xsd:documentation></xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>