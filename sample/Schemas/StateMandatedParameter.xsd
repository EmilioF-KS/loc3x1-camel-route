<?xml version="1.0" encoding="UTF-8"?><xsd:schema targetNamespace="http://ei/core/state_mandated_parameter" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:complexType name="StateMandatedParameter">
		<xsd:sequence>
			<xsd:element minOccurs="0" name="ParameterSequenceNumber" type="xsd:string">
        <xsd:annotation>
          <xsd:documentation>This element contains the sequence number assigned to the parameter.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ParameterTypeCode" type="xsd:string">
        <xsd:annotation>
          <xsd:documentation>This element contains a code that indenties the parameter data.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ParameterTypeDescription" type="xsd:string">
        <xsd:annotation>
          <xsd:documentation>This element contains a description that indenties the parameter data.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ParameterValue" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a string parameter value.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ParameterDate" type="xsd:date">
				<xsd:annotation>
          <xsd:documentation>This element contains a date parameter value.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ParameterNumber" type="xsd:decimal">
				<xsd:annotation>
          <xsd:documentation>This element contains a number parameter value.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>