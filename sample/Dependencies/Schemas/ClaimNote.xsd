<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://ei/core/claim_note">
	<xsd:complexType name="ClaimNote">
		<xsd:sequence>
			<xsd:element minOccurs="0" name="ClaimNoteId"
				type="xsd:integer">
				<xsd:annotation><xsd:documentation>This element is a unique identifier for the claim note.</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="ClaimNoteCreatedDate"
				type="xsd:date">
				<xsd:annotation><xsd:documentation>This element specifies the date the claim note was created.</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="ClaimNoteCreatorName"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element is the name of the person who created the claim note.</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="ClaimNoteCreatorId"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element is the of the person who created the claim note.</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="ClaimNoteTitleName"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element is the title of the claim note.</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="ClaimNoteCategoryId"
				type="xsd:integer">
				<xsd:annotation><xsd:documentation>This element is the unique identifier for the claim note category type.</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="ClaimNoteCategoryName"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element is the category name of the claim note.</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="ClaimNoteSubCategoryName"
				type="xsd:string"><xsd:annotation><xsd:documentation>This element is the subcategory name of the claim note.</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="ClaimNotePriorityName"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element is the priority of the claim note, such as high, medium, low.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ClaimNoteAccessibilityName"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element is the accesibility name of the claim note, such as general or private.</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0"
				name="ClaimNoteSystemGeneratedIndicator" type="xsd:boolean"><xsd:annotation><xsd:documentation>This element specifies whether a claim note is system generated.</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0"
				name="ClaimNoteSignificantIndicator" type="xsd:boolean"><xsd:annotation><xsd:documentation>This element specifies whether a claim note is significant.</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0"
				name="ClaimNoteAttachmentIndicator" type="xsd:boolean"><xsd:annotation><xsd:documentation>This element specifies whether a claim note has an attachment.</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="ClaimNoteDraftIndicator"
				type="xsd:boolean"><xsd:annotation><xsd:documentation>This element specifies whether a claim note is a draft.</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0"
				name="ClaimNoteFinalVersionDateTime" type="xsd:dateTime"><xsd:annotation><xsd:documentation>This element specifies the date time of the final version of the claim note.</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="ClaimNoteFormatName"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>&lt;p&gt;
    This element is the content format of the the claim note, such as HTML or plain text.
&lt;/p&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="ClaimNoteText"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element contains the claim note text.</xsd:documentation></xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0"
				name="ClaimNoteDisplayOrderNumber" type="xsd:integer">
				<xsd:annotation><xsd:documentation>This element is the order in which the claim notes should be displayed.</xsd:documentation></xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>