<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://ei/core/product_identifier"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:complexType name="ProductIdentifier">
		<xsd:sequence>
			<xsd:element minOccurs="0"
				name="ProductCatalogPCMPOMasterGIN" type="xsd:string"><xsd:annotation><xsd:documentation>This element contains the Product Component GIN from the enterprise product catalog.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="InsurerProductCode"
				type="xsd:string">
			</xsd:element>
			<xsd:element minOccurs="0" name="StateOrProvinceCode"
				type="xsd:string"><xsd:annotation><xsd:documentation>This element is a code for a state, province or territory within a country or nation.
The E1T00111 Corporate Table contains valid values for this element in the &quot;ST_PROV_C&quot; column. 
 				</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="CountryCode"
				type="xsd:string"><xsd:annotation><xsd:documentation>This element is a code for a country, nation or political state.
The E1T00101 Corporate Table contains valid values for this element in the &quot;CNTRY_C&quot; column. 
				</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ProductEffectiveDate"
				type="xsd:date"><xsd:annotation><xsd:documentation>This element contains the effective date of the Product.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ProductExpirationDate"
				type="xsd:date"><xsd:annotation><xsd:documentation>This element contains the expiration date of the Product.</xsd:documentation></xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>