\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Legacy-to-modern translation pipeline. Client artefacts (top cluster) feed the PoC (bottom cluster): WSDL/XSD drive POJO generation via \texttt  {wsdl2java}/\texttt  {xjc}; BPEL flow is manually translated into Camel route logic; \texttt  {.map} specifications become XSLT stylesheets invoked by the route to transform LOC3X1M responses into LOC3X1B format; final XML is written to \texttt  {CHUBB/output/loc3x1\_result.xml} for regression testing.}}{12}{figure.caption.8}\protected@file@percent }
\newlabel{fig:translation-pipeline}{{1}{12}{Legacy-to-modern translation pipeline. Client artefacts (top cluster) feed the PoC (bottom cluster): WSDL/XSD drive POJO generation via \texttt {wsdl2java}/\texttt {xjc}; BPEL flow is manually translated into Camel route logic; \texttt {.map} specifications become XSLT stylesheets invoked by the route to transform LOC3X1M responses into LOC3X1B format; final XML is written to \texttt {CHUBB/output/loc3x1\_result.xml} for regression testing}{figure.caption.8}{}}
