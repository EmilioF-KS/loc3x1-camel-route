<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://ei/core/location_occupancy_aggregationx1"
	xmlns:bons0="http://ei/core/location_occupancy_calculation"
	xmlns:bons1="http://ei/core/limitx2"
	xmlns:bons3="http://ei/core/exposurex1"
	xmlns:bons4="http://ei/core/premiumx6">
	<xsd:import schemaLocation="PremiumX6.xsd"
		namespace="http://ei/core/premiumx6">
	</xsd:import>
	<xsd:import namespace="http://ei/core/exposurex1"
		schemaLocation="Exposurex1.xsd">
	</xsd:import>
	<xsd:import
		namespace="http://ei/core/location_occupancy_calculation"
		schemaLocation="LocationOccupancyCalculation.xsd">
	</xsd:import>

	<xsd:import namespace="http://ei/core/limitx2"
		schemaLocation="LimitX2.xsd">
	</xsd:import>

	<xsd:complexType name="LocationOccupancyAggregation">
		<xsd:sequence>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="Exposure" type="bons3:Exposure">
			</xsd:element>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="Limit" type="bons1:Limit">
			</xsd:element>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="Premium" type="bons4:Premium">
			</xsd:element>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="LocationOccupancyCalculation"
				type="bons0:LocationOccupancyCalculation">
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>