<?xml version="1.0" encoding="UTF-8"?><xsd:schema targetNamespace="http://ei/core/surchargex1" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:complexType name="Surcharge">
		<xsd:sequence>
			<xsd:element minOccurs="0" name="SurchargeTypeReferenceCode" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element indentifies the type of surcharge a state may asses.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="SurchargeName" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a name that identifies a specific surcharge type.  </xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="SurchargeLineOfBusinessCode" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element indenties which line of business the surcharge rate should be applied to.  
Surcharge Lines Of Business are specific to surcharge processing and are not consistent with other Lines Of Business definitions.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="SurchargePercent" type="xsd:decimal">
				<xsd:annotation>
          <xsd:documentation>This element contains the percent of the surcharge to be paid.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="SurchargeAmount" type="xsd:decimal">
				<xsd:annotation>
          <xsd:documentation>This element contains the amount os state surcharge that has been paid by the Insured or mortgagee.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="SurchargeCurrencyCode" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a code which indentifies the currency of the surcharge amount.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="SurchargeRate" type="xsd:decimal">
				<xsd:annotation>
          <xsd:documentation>This element contains the rate that will be applied to determine the Surcharge Amount.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="PostalStateAbbreviation" type="xsd:string">
        <xsd:annotation>
          <xsd:documentation>This element is the two character US Postal State Abbreviation. 
The E1T00111 Corporate Table contains valid values for this element in the "PSTL_ST_AB" column. 
				</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>