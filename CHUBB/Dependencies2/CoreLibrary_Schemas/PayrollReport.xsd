<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://ei/core/payroll_report"
	xmlns:bons0="http://ei/core/premiumx7"
	xmlns:bons1="http://ei/core/surchargex2"
	xmlns:bons2="http://ei/core/taxx2" xmlns:bons3="http://ei/core/fee"
	xmlns:bons4="http://ei/core/exposurex2"
	xmlns:bons5="http://ei/core/customizationx2">
	<xsd:import schemaLocation="CustomizationX2.xsd"
		namespace="http://ei/core/customizationx2">
	</xsd:import>
	<xsd:import schemaLocation="Exposurex2.xsd"
		namespace="http://ei/core/exposurex2">
	</xsd:import>
	<xsd:import schemaLocation="Fee.xsd"
		namespace="http://ei/core/fee">
	</xsd:import>
	<xsd:import schemaLocation="TaxX2.xsd"
		namespace="http://ei/core/taxx2">
	</xsd:import>
	<xsd:import namespace="http://ei/core/surchargex2"
		schemaLocation="SurchargeX2.xsd">
	</xsd:import>
	<xsd:import namespace="http://ei/core/premiumx7"
		schemaLocation="PremiumX7.xsd">
	</xsd:import>
	<xsd:complexType name="PayrollReport">
		<xsd:sequence>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="Surcharge" type="bons1:Surcharge">
			</xsd:element>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="Premium" type="bons0:Premium">
			</xsd:element>
			<xsd:element minOccurs="0" name="Tax" type="bons2:Tax"
				maxOccurs="unbounded">
			</xsd:element>
			<xsd:element minOccurs="0" name="Fee" type="bons3:Fee"
				maxOccurs="unbounded">
			</xsd:element>
			<xsd:element minOccurs="0" name="Exposure"
				type="bons4:Exposure" maxOccurs="unbounded">
			</xsd:element>
			<xsd:element minOccurs="0" name="Customization"
				type="bons5:Customization" maxOccurs="unbounded">
			</xsd:element>
			<xsd:element minOccurs="0" name="PayrollReportingStartDate"
				type="xsd:date">
				<xsd:annotation><xsd:documentation>&lt;br /&gt;
&lt;p&gt;
    This element contains the start date of the payroll report.
&lt;/p&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="PayrollReportingEndDate"
				type="xsd:date">
				<xsd:annotation><xsd:documentation>This element contains the end date of the payroll report.</xsd:documentation></xsd:annotation>
			</xsd:element>


			<xsd:element minOccurs="0" name="PayrollReportStatusName"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>&lt;br /&gt;
&lt;p&gt;
    This element contains the status of the payroll report.&amp;nbsp; Valid values include, 'Pending', 'Error' and 'Complete'.
&lt;/p&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="PayrollReportErrorDescription" type="xsd:string">
				<xsd:annotation><xsd:documentation>&lt;br /&gt;
&lt;p&gt;
    This element contains the error description for the payroll report, when an error occured.
&lt;/p&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>