<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://ei/core/loss_control_survey"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:bons0="http://ei/core/survey_recommendation"
	xmlns:bons3="http://ei/core/survey_contactx1"
	xmlns:bons1="http://ei/core/document_set"
	xmlns:bons2="http://ei/core/customizationx2">
	<xsd:import schemaLocation="CustomizationX2.xsd"
		namespace="http://ei/core/customizationx2">
	</xsd:import>
	<xsd:import schemaLocation="DocumentSet.xsd"
		namespace="http://ei/core/document_set">
	</xsd:import>
	<xsd:import schemaLocation="SurveyContactX1.xsd"
		namespace="http://ei/core/survey_contactx1">
	</xsd:import>


	<xsd:import schemaLocation="SurveyRecommendation.xsd"
		namespace="http://ei/core/survey_recommendation">
	</xsd:import>
	<xsd:complexType name="LossControlSurvey">
		<xsd:sequence>
			<xsd:element minOccurs="0" name="SurveyRecommendation"
				type="bons0:SurveyRecommendation" maxOccurs="unbounded">
			</xsd:element>
			<xsd:element minOccurs="0" name="SurveyContact"
				type="bons3:SurveyContact" maxOccurs="unbounded">
			</xsd:element>
			<xsd:element minOccurs="0" name="DocumentSet"
				type="bons1:DocumentSet" maxOccurs="unbounded">
			</xsd:element>
			<xsd:element minOccurs="0" name="SurveyRequestNumber"
				type="xsd:integer"><xsd:annotation><xsd:documentation>This element contains the number assigned to the survey request.  </xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="LossControlOnsiteVisitIndicator" type="xsd:boolean">
				<xsd:annotation><xsd:documentation>This element indicates if loss control physically visited the site.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="LossControlVisitDate"
				type="xsd:date">
				<xsd:annotation><xsd:documentation>This element contains the date of the loss control visit. The visit may be physically on-site or virtually off-site. For a virtual visit this date represents the date survey work is completed.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="Customization"
				type="bons2:Customization" maxOccurs="unbounded">
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>