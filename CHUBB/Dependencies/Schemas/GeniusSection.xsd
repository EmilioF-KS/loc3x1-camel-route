<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://ei/core/genius_section">
	<xsd:complexType name="GeniusSection">
		<xsd:sequence>
			<xsd:element minOccurs="0" name="GeniusSectionTypeCode"
				type="xsd:string"><xsd:annotation><xsd:documentation>This element contains a code which identifies the type of section within Genius.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="GeniusSubSectionTypeCode"
				type="xsd:string"><xsd:annotation><xsd:documentation>This element contains a code which identifies the type of sub-section within Genius.</xsd:documentation></xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>