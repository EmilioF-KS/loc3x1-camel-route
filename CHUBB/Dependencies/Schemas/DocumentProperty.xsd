<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://ei/core/document_property"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:complexType name="DocumentProperty">
		<xsd:sequence>
			<xsd:element minOccurs="0" name="DocumentPropertyName"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element contains the name of the document property.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DocumentPropertyValue"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element contains the value of a document property.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DocumentPropertyDate"
				type="xsd:date">
				<xsd:annotation><xsd:documentation>This element contains a date of a document property.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DocumentPropertyIndicator"
				type="xsd:boolean">
				<xsd:annotation><xsd:documentation>This element contains a indicator for a document property.</xsd:documentation></xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>