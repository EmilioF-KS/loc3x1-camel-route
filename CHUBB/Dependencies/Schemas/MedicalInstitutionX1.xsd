<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://ei/core/medical_institutionx1"
	xmlns:bons1="http://ei/core/addressx2">
	<xsd:import schemaLocation="AddressX2.xsd"
		namespace="http://ei/core/addressx2">
	</xsd:import>
	<xsd:complexType name="MedicalInstitution">
		<xsd:sequence>
			<xsd:element minOccurs="0" name="MedicalInstitutionName"
				type="xsd:string"><xsd:annotation><xsd:documentation>This element contains the name of a medical institution, which could be hospital , clinic or laboratory.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="Address"
				type="bons1:Address">
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
