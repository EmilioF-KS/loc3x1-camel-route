<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
	targetNamespace="http://ei/core/region_and_language_settings"
	xmlns:Q1="http://ei/core/time_zone"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:bons1="http://ei/core/languagex1">
	<xsd:import schemaLocation="TimeZone.xsd"
		namespace="http://ei/core/time_zone">
	</xsd:import>
	<xsd:import schemaLocation="LanguageX1.xsd"
		namespace="http://ei/core/languagex1">
	</xsd:import>
	<xsd:complexType name="RegionAndLanguageSettings">
		<xsd:sequence>
			<xsd:element minOccurs="0" name="Language"
				type="bons1:Language">
			</xsd:element>
			<xsd:element minOccurs="0" name="TimeZone"
				type="Q1:TimeZone">
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>