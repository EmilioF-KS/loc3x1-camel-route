<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://ei/core/entity_alias_namex1"
	xmlns:bons1="http://ei/core/business_party_characteristic"
	xmlns:bons2="http://ei/core/individual_informationx2">
	<xsd:import schemaLocation="IndividualInformationX2.xsd"
		namespace="http://ei/core/individual_informationx2">
	</xsd:import>
	<xsd:import namespace="http://ei/core/business_party_characteristic"
		schemaLocation="BusinessPartyCharacteristic.xsd">
	</xsd:import>

	<xsd:complexType name="EntityAliasName">
		<xsd:sequence>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="BusinessPartyCharacteristic"
				type="bons1:BusinessPartyCharacteristic">
			</xsd:element>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="IndividualInformation" type="bons2:IndividualInformation">
			</xsd:element>

			<xsd:element minOccurs="0" name="EnterpriseOwnershipCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>
This element describes the regulatory system under which a  company is organized and operated (e.g. PUBLIC, PRIVATE, NON-PROFIT).
The E1T00291 Corporate Table contains valid values for this element in the "ENTRPRS_OWNER_C" column. 
					</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="SourceSystemOwnershipCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element describes the regulatory system under which a company is organized and operated (e.g. PUBLIC, PRIVATE,
NON-PROFIT) as it is known by the source system.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="AliasNameTypeCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element tells you if the alias name is a person{personal} or a business name{commercial}.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="AliasName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>&lt;br /&gt;
&lt;p&gt;
    This element contains another name an entity is known as.
&lt;/p&gt;</xsd:documentation>
        </xsd:annotation>
			</xsd:element>

		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>