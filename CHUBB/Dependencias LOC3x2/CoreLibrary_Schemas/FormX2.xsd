<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://ei/core/formx2"
	xmlns:bons0="http://ei/core/customizationx1"
	xmlns:bons2="http://ei/core/question_and_answerx1">
	<xsd:import namespace="http://ei/core/question_and_answerx1"
		schemaLocation="QuestionAndAnswerX1.xsd" />
	<xsd:import namespace="http://ei/core/customizationx1"
		schemaLocation="CustomizationX1.xsd">
	</xsd:import>
	<xsd:complexType name="Form">
		<xsd:sequence>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="QuestionsAndAnswers" type="bons2:QuestionAndAnswer">
			</xsd:element>
			<xsd:element minOccurs="0" name="FormCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the code that indentifies a Form.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="FormName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the name of a Chubb, Government, or other standard form.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>


			<xsd:element minOccurs="0" name="FormSequenceNumber"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element indentifies the order in which forms are attached to a policy or transaction.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="FormIssueDate"
				type="xsd:date">
				<xsd:annotation>
          <xsd:documentation>This element contains the date when a form was issued.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="FormRevisionEditionDate"
				type="xsd:date">
				<xsd:annotation>
          <xsd:documentation>This element contains the date when the form text was last modified.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="FormVersionNumber"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element indentifies the particular version of a Form.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="RelatedFormCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the Form Code of a related form, such as a parent form.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="AssociatedPolicyLevelName"
				type="xsd:string">
				<xsd:annotation>
          
        <xsd:documentation>This element contains the name of the Policy Level to which this Form is attached. Valid values include "Policy",
"LineOfInsurance", "LOB",&amp;nbsp;"Subject" or the name of a Subject, "Coverage" or the name of a Coverage.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="AsoociatedPolicyLevelNumber" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the number of the Policy to which this form is associated.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="AssociatedPolicyLevelCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the coverage code or line of insurance type code on the the Policy to which this form is associated.  The value in "AssociatedPolicyLevelName" allows which code is provided to be distinguished.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="UnderwriterApprovalIndicator" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element indicates if the underwriter has reviewed and approved the Form.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="FormPrintIndicator"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element is used to indicate if this form should be printed.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="AssociatedParentLevelName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element the name of the parent (the level above) level of the policy level to which a form is attached.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="AssociatedParentLevelCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a code of the parent (the level above) level of the policy level to which a form is attached.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="AssociatedPolicyLevelItemId" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains an id that uniquely identifies an instance of the item within a particular level of the Policy model.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="FormCategoryGroupName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element is the name of the descriptive grouping to which forms are assigned. Some valid values include: declaration,
amendment, endorsement, and correspondence</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="FormRevisionEditionYearMonth" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the year and month the form text was last modified.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="FormFormatCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>&lt;SPAN style='FONT-SIZE: 12pt; FONT-FAMILY: "Times New Roman","serif"; COLOR: black; mso-fareast-font-family: "Times New Roman"; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA'&gt;
&lt;P class=MsoNormal style="MARGIN: 0in 0in 0pt; mso-list: l0 level1 lfo1"&gt;&lt;FONT size=3&gt;&lt;FONT face="Times New Roman"&gt;This element contains a code that identifies the structure of the Form that is part of the contract, such as f&lt;SPAN style="COLOR: black"&gt;ixed text, variable text, and fixed text with variable data.&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/P&gt;&lt;/SPAN&gt;</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="Customization" type="bons0:Customization">
			</xsd:element>
			<xsd:element minOccurs="0" name="FormCategoryGroupCode"
				type="xsd:string"><xsd:annotation><xsd:documentation>&lt;br /&gt;
&lt;p&gt;
    This element contains a code&amp;nbsp;for the&amp;nbsp;grouping to which forms are assigned. Some valid groups include:
    declaration, amendment, endorsement, and correspondence
&lt;/p&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="FormCategorySequenceNumber"
				type="xsd:string"><xsd:annotation><xsd:documentation>&lt;br /&gt;
&lt;p&gt;
    This element contains the sequence of the forms within the category.
&lt;/p&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>