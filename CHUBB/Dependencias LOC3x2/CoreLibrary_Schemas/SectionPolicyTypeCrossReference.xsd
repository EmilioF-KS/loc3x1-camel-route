<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://ei/core/section_policy_type_cross_reference">
	<xsd:complexType name="SectionPolicyTypeCrossReference">
		<xsd:sequence>

			<xsd:element minOccurs="0" name="SequenceNumber"
				type="xsd:integer">
			</xsd:element>
			<xsd:element minOccurs="0" name="SectionTypeCode"
				type="xsd:string">
			</xsd:element>
			<xsd:element minOccurs="0" name="SectionTypeSubCode"
				type="xsd:string">
			</xsd:element>

			<xsd:element minOccurs="0" name="PolicyTypeCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element identifies the type of the insurance contract with a code. The Corporate table E1T00221 contain the valid
values for this element in the "POL_TY_C" column.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="PolicyTypeSubCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>The element is used to divide Policy Type Code in order to provide more categories for some insurance contracts. (This is
also known as PolicySubTypeCode.) The Corporate table E1T00221 contain the valid values for this element if the
"POL_SUB_TY_C" column.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="PolicyTypeEnglishAbbreviation" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element is the name assigned to a policy that represents the type of insurance contract. The Corporate table E1T00221
contain the valid values for this element if the "POL_TY_AB" column.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="MarketingProgramCode"
				type="xsd:string"><xsd:annotation><xsd:documentation>This element identifies policies written as part of a specific marketing program. The Corporate table E1T00091 contains
valid values for this element in the "MRKTG_PGM_C" column.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="ManagementResponsibilityCode" type="xsd:string"><xsd:annotation><xsd:documentation>&lt;p&gt;
    This element contains a business category designated by P&amp;amp;C management for use in analysis of profit (LOSS)
    results; the second level of management oriented data elements.
&lt;/p&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>