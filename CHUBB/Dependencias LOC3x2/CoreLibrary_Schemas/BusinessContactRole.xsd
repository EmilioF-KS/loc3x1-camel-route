<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://ei/core/business_contact_role"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:complexType name="BusinessContactRole">
		<xsd:sequence>
			<xsd:element name="ContactRoleCode" type="xsd:string"
				nillable="true" minOccurs="0">
				<xsd:annotation>
						<xsd:documentation>This element  uniquely identifies a contact role.</xsd:documentation>
					</xsd:annotation>
			</xsd:element>
			<xsd:element name="ContactRoleName" type="xsd:string"
				nillable="true" minOccurs="0">
				<xsd:annotation>
						<xsd:documentation>This element contains the name of a contact role.</xsd:documentation>
					</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>