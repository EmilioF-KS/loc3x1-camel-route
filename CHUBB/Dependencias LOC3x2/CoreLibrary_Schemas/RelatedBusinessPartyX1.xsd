<?xml version="1.0" encoding="UTF-8"?><xsd:schema targetNamespace="http://ei/core/related_business_partyx1" xmlns:Q1="http://ei/core/business_partyx1" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:import namespace="http://ei/core/business_partyx1" schemaLocation="BusinessPartyX1.xsd"/>
	<xsd:complexType name="RelatedBusinessParty">
		<xsd:complexContent>
			<xsd:extension base="Q1:BusinessParty">

				<xsd:sequence>
					<xsd:element minOccurs="0" name="BPRelationshipCode" type="xsd:string">
						<xsd:annotation>
              <xsd:documentation>This element contains a code that identifies the position within a company or a relationship to an individual that may exist for a business party.
The E1T00861 Corporate Table contains valid values for this element in the "CNTRCT_PRTC_REL_C" column. 
				
</xsd:documentation>
            </xsd:annotation>
					</xsd:element>
					<xsd:element minOccurs="0" name="BPRelationshipDescription" type="xsd:string">
						<xsd:annotation>
              <xsd:documentation>This element describes a position with a company or a relationship to an individual that may exist for a business party.
The E1T00861 Corporate Table contains valid values for this element in the "CNTRCT_PRTC_REL_DE" column.</xsd:documentation>
            </xsd:annotation>
					</xsd:element>
					<xsd:element minOccurs="0" name="BPInverseRelationshipCode" type="xsd:string">
						<xsd:annotation>
              <xsd:documentation>This element contains a code that identifies the inverse relationship a business party may have with a company or individual.
The E1T00861 Corporate Table contains valid values for this element in the "CNTRCT_PRTC_INVR_C" column.


</xsd:documentation>
            </xsd:annotation>
					</xsd:element>
					<xsd:element minOccurs="0" name="BPInverseRelationshipDescription" type="xsd:string">
						<xsd:annotation>
              <xsd:documentation>This element describes the inverse relationship a business party may have with a company or individual.
 The E1T00861 Corporate Table contains valid values for this element in the "CNTRCT_PRTC_REL_DE" column.</xsd:documentation>
            </xsd:annotation>
					</xsd:element>
					<xsd:element maxOccurs="unbounded" minOccurs="0" name="HouseholdDurableKey" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>This element conatins an unique identifier assigned to an instance of a Chubb household for its entire lifetime.</xsd:documentation>
            </xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
</xsd:schema>