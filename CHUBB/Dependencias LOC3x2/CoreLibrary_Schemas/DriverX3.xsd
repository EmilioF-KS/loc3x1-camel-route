<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://ei/core/driverx3"
	xmlns:bons0="http://ei/core/loss_type"
	xmlns:bons1="http://ei/core/driver_violation"
	xmlns:bons3="http://ei/core/business_party_characteristic"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:bons2="http://ei/core/typed_addressx3">
	<xsd:import schemaLocation="TypedAddressX3.xsd"
		namespace="http://ei/core/typed_addressx3">
	</xsd:import>
	<xsd:import namespace="http://ei/core/driver_violation"
		schemaLocation="DriverViolation.xsd" />
	<xsd:import namespace="http://ei/core/loss_type"
		schemaLocation="LossType.xsd">
	</xsd:import>
	<xsd:import namespace="http://ei/core/business_party_characteristic"
		schemaLocation="BusinessPartyCharacteristic.xsd">
	</xsd:import>


	<xsd:complexType name="Driver">
		<xsd:sequence>

			<xsd:element minOccurs="0" name="DriverSequenceNumber"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a unique sequence number assigned to the driver, which remains the same during the life of a policy.  

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DriverName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains name of a driver.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DriverBirthDate"
				type="xsd:date">
				<xsd:annotation>
          <xsd:documentation>This element contains contains the birth date of the driver.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DriverMaritalStatusCode"
				type="xsd:string">
				<xsd:annotation>
          
        <xsd:documentation>This element contains the code that identifies the marital status of the driver. Valid options for this element are: 'S'-
Single, 'D' - Divorced, 'M'-Married, 'W'-Widowed, or spaces.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DriverOperatorCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a code that identifies if the driver is a principal or non-principal operator of the vehicle they are assigned to.
Valid options for this element are 'P'-Principal or 'N' - Non-Principal.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DrivingRecordCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a code that indentifies the number or years driving experience without a claim.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="DriverLicenseNumber"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the number issued by a state's Department of Motor Vehicle for a driver’s license.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DriverLicensedDate"
				type="xsd:date">
				<xsd:annotation>
          <xsd:documentation>This element contains the date when the individual became a licensed driver.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="DriverPostalStateAbbreviation" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the abbreviation of the state or province where the principal driver's license was issued.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DriverGenderCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a code that identifies the gender of the driver.
Valid options for this element are 'F'-Female or 'M'-Male.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0"
				name="NumberOfDriverEligibilityPoints" type="xsd:integer">
				<xsd:annotation>
          <xsd:documentation>This element contains the number of eligibility points for the driver.  Eligibility points are given include points for inexperience operator, chargeable accidents and motor vehicle points.
</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="NumberOfBodilyInjuryAtFaultAccidents" type="xsd:integer">
				<xsd:annotation>
          <xsd:documentation>This element contains the number of at fault accidents which have resulted in bodily injury for the preceding three years.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="NumberOfPropertyDamageAtFaultAccidents" type="xsd:integer">
				<xsd:annotation>
          <xsd:documentation>This element contains the number of at fault accidents which have resulted in damage to properly only for the preceding three years.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="NumberOfWaivedStandardViolationPoints" type="xsd:integer">
				<xsd:annotation>
          <xsd:documentation>This element contains the number of automobile violation points which were waived in the pricing of the policy for the driver.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DriverLicenseCountryCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element is a code for a country, nation or political state where the Driver's license was issued.
The E1T00101 Corporate Table contains valid values for this element in the "CNTRY_C" column.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DriverLicenseCopyIndicator"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element specifies whether a copy of the driver's license was submitted.
Valid options for this element are 'Y' or 'N'
</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="NumberOfYearsLicensed"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the number of years a driver has had their license.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="PrefixName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the prefix placed before a person's name.
Some valid options for this element include 'Mr.', 'Mrs.', 'Dr.'.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="GivenName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a person's first name.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="MiddleInitial"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the first letter from a person's middle name.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="Surname"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a person's last name.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="NameSuffix"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the suffix that follows a person’s full name and provides additional information about the person. There are academic, honorary, professional, and social name suffixes.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="BusinessPartyCharacteristic"
				type="bons3:BusinessPartyCharacteristic">
			</xsd:element>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="DriverViolation" type="bons1:DriverViolation">
			</xsd:element>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="LossType" type="bons0:LossType">
			</xsd:element>
			<xsd:element minOccurs="0" name="DriverId"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the number used to uniquely identify a driver.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DriverLicenseTypeName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element indentifies the type of drivers license.
Some valid values include Licensed Driver and Permit Driver.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="MiddleName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a person's middle name.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="OccupationDescription"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a short description of an individual's occupation.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="OccupationDetailDescription" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a detailed description of an individual's occupation.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>






			<xsd:element minOccurs="0" name="DriverUseCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a code which indicates the drivers use of the vehicle, such as pleasure, non-pleasure, and business.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="MessageDriverId"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains an Id assigned for the  lifetime of the message that will be used to identify the Driver.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="RelatedDriverId"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the Id of a related driver.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="DriverPrincipalOperatorCode" type="xsd:string">
				<xsd:annotation><xsd:documentation>&lt;br /&gt;
&lt;br /&gt;
&lt;p&gt;
    This element contains a code that identifies whether the driver is a principal or non-principal operator of the vehicle
    they are assigned.
&lt;/p&gt;
&lt;br /&gt;
&lt;p&gt;
    Values may vary by Policy Admin System.
&lt;/p&gt;
&lt;br /&gt;
&lt;p&gt;
    The valid values for PLS include:
&lt;/p&gt;
&lt;p&gt;
    &amp;nbsp;'P' principal
&lt;/p&gt;
&lt;p&gt;
    &amp;nbsp;'N' non principal
&lt;/p&gt;
&lt;p&gt;
    &amp;nbsp; or blank.
&lt;/p&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="DriverPrincipalOperatorName" type="xsd:string">
				<xsd:annotation><xsd:documentation>&lt;p&gt;
    This element identifies whether the driver is a principal or non-principal operator of the vehicle they are assigned.
&lt;/p&gt;
&lt;br /&gt;
&lt;p&gt;
    Values may vary by Policy Admin System.
&lt;/p&gt;
&lt;br /&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DriverMaritalStatusName"
				type="xsd:string"><xsd:annotation><xsd:documentation>This element&amp;nbsp;identifies the marital status of the driver.</xsd:documentation></xsd:annotation>
			</xsd:element>


			<xsd:element minOccurs="0" name="InsuredRelationshipCode"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;SPAN style='FONT-SIZE: 10pt; FONT-FAMILY: &quot;Arial&quot;,&quot;sans-serif&quot;'&gt;This&amp;nbsp;element contains a code that identifiers the relationship between this business party and the Insured.&lt;?xml:namespace prefix = &quot;o&quot; ns = &quot;urn:schemas-microsoft-com:office:office&quot; /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="InsuredRelationshipDescription" type="xsd:string">
				<xsd:annotation><xsd:documentation>&lt;SPAN style='FONT-SIZE: 10pt; FONT-FAMILY: &quot;Arial&quot;,&quot;sans-serif&quot;'&gt;
&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;SPAN style='FONT-SIZE: 10pt; FONT-FAMILY: &quot;Arial&quot;,&quot;sans-serif&quot;'&gt;This&amp;nbsp;element&amp;nbsp;identifies the relationship between this business party and the Insured.&lt;?xml:namespace prefix = &quot;o&quot; ns = &quot;urn:schemas-microsoft-com:office:office&quot; /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="FirstLicenseDate"
				type="xsd:date"><xsd:annotation><xsd:documentation>&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;SPAN style='FONT-SIZE: 10pt; FONT-FAMILY: &quot;Arial&quot;,&quot;sans-serif&quot;'&gt;This element contains the date the driver first received their license.&lt;?xml:namespace prefix = &quot;o&quot; ns = &quot;urn:schemas-microsoft-com:office:office&quot; /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="TypedAddress"
				type="bons2:TypedAddress" maxOccurs="unbounded">
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>