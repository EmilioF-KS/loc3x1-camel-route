<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://ei/core/reinsurance_information"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:complexType name="ReinsuranceInformation">
		<xsd:sequence>
			<xsd:element minOccurs="0" name="ReinsuranceCededCoverCode"
				type="xsd:string">
				<xsd:annotation>
								<xsd:documentation>
This element is a code that uniquely identifies a specific ceded reinsurance contract.  
Multiple ceded contracts (covers) may apply to any one coverage or coverage/subject combination.
								</xsd:documentation>
							</xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ReinsuranceCededCompany"
				type="xsd:string">
				<xsd:annotation>
								<xsd:documentation>
This element is a code for the Insurance Company or group of companies which the risk
has been ceded.</xsd:documentation>
							</xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ReinsuranceCededPremium"
				type="xsd:decimal">
				<xsd:annotation>
								<xsd:documentation>
This element specifies the amount of gross written premium that is ceded to the reinsurer(s)
in compensation for the risk transfer provided.</xsd:documentation>
							</xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="ReinsuranceCededTermPremium" type="xsd:decimal">
				<xsd:annotation>
								
							<xsd:documentation>
This element specifies the *Reinsurance Ceded Premium Amount* for the full policy term, 
but is grossed up on mid-term transactions for a coverage, coverage/subject combination.
</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="ReinsuranceCededCommisionAmount" type="xsd:decimal">
				<xsd:annotation>
								<xsd:documentation>
This element specifices amount of money paid by the reinsurer for the placement of the
business with them.</xsd:documentation>
							</xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ReinsuranceLimit"
				type="xsd:integer">
				<xsd:annotation>
								<xsd:documentation>
This element specifies the maximum amount of risk The Chubb Group cedes to the Reinsurer.</xsd:documentation>
							</xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="ReinsuranceCedeQuotaSharePercent" type="xsd:decimal">
				<xsd:annotation>
								<xsd:documentation>
This element specifies the relationship between the amount paid by the Reinurer
and the total amount of every claim dollar paid under a Quota Share Reinsurance Agreement.</xsd:documentation>
							</xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ReinsuranceCurrencyCode"
				type="xsd:string">
				<xsd:annotation>
                <xsd:documentation>This element is the currency code for the Reinsurance.</xsd:documentation>
              </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ReinsuranceEffectiveDate"
				type="xsd:date"><xsd:annotation><xsd:documentation>This element contains the date when the insurance protection begins, is terminated, or is changed.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ReinsuranceExpirationDate"
				type="xsd:date"><xsd:annotation><xsd:documentation>This element contains the date the policy or bond ceases to provide coverage.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ReinsuranceSequenceNumber"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element is unique for each reinsurance arrangement within a policy term and is assigned at booking by the originating system. </xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ReinsuranceCessionTypeCode"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element contains a code that identifies the type of reinsurance, such as proportional or excess.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="ReinsurancePolicyReferenceCode" type="xsd:string">
				<xsd:annotation><xsd:documentation>This element contains the symbol for identifying the Policy Number used by the Reinsurance Company to identify their contract.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="ReinsuranceCededPremiumPercent" type="xsd:decimal">
				<xsd:annotation><xsd:documentation>This element specifies the percent of gross written premium that is ceded to the reinsurer(s) for this coverage in compensation for the risk transfer provided.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="ReinsuranceCededCommissionPercent" type="xsd:decimal">
				<xsd:annotation><xsd:documentation>This element contains the percent of the commission retained when the reinsurance premium is ceded.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="ReinsuranceCededLossPercent" type="xsd:decimal">
				<xsd:annotation><xsd:documentation>This element contains the  percent of total loss for which the reinsurance company is responsible.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="ReinsuranceExcessStartAmount" type="xsd:decimal">
				<xsd:annotation><xsd:documentation>This element contains the amount of exposure at which the reinsurance company takes responsibility for the loss.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ReinsuranceExcessLossLimit"
				type="xsd:decimal">
				<xsd:annotation><xsd:documentation>This element contains the maximum amount of coverage provided by the reinsurer, which begins when the loss exceeds the amount specified by the reinsurance excess start.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="ReinsuranceLocationDescription" type="xsd:string">
				<xsd:annotation><xsd:documentation>This element contains a description of the location being reinsured.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ReinsuranceUpdateCode"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element contains a code that identifies that the type of change being made to reinsurance, such as Add, Change or Delete.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ReinsuranceBrokerCode"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element contains a code that identifies the reinsurance broker.</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="ReinsuranceCededContractCode" type="xsd:string"><xsd:annotation><xsd:documentation>This element is a code for the Reinsurance Agreement which can apply to a gross entry when generating Reinsurance.</xsd:documentation></xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>