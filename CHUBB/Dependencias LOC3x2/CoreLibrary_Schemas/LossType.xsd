<?xml version="1.0" encoding="UTF-8"?><xsd:schema targetNamespace="http://ei/core/loss_type" xmlns:bons1="http://ei/core/loss_history" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <xsd:import namespace="http://ei/core/loss_history" schemaLocation="LossHistory.xsd"/>
	<xsd:complexType name="LossType">
		<xsd:sequence>
			<xsd:element maxOccurs="unbounded" minOccurs="0" name="LossHistory" type="bons1:LossHistory">
			</xsd:element>
			<xsd:element minOccurs="0" name="LossTypeName" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the name which describes the loss as being a certain line of business, such as Valuable Articles, Home, and Home Liability.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="MessageLossTypeId" type="xsd:string">
        <xsd:annotation>
          <xsd:documentation>This element contains an Id assigned for the  lifetime of the message that will be used to identify the Loss Type.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>