<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://ei/core/deductiblex3"
	xmlns:bons0="http://ei/core/customization">
	<xsd:import schemaLocation="Customization.xsd"
		namespace="http://ei/core/customization">
	</xsd:import>
	<xsd:complexType name="Deductible">
		<xsd:sequence>
			<xsd:element minOccurs="0"
				name="DeductibleTypeReferenceCode" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a code that identifies a specific deductible type.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DeductibleName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the name that identifies a specific deductible type.  </xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DeductibleAmount"
				type="xsd:decimal">
				<xsd:annotation>
          <xsd:documentation>This element contains the amount of a loss for which the insured agrees to assume liability.  </xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DeductibleCurrencyCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a code which indentifies the currency of the deductible amount.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DeductibleAmountTypeName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element describes the type of data contained in the deductible amount.
Valid values for this element include Currency, Distance, Time, and Quantity.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="UnitOfMeasure"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element specifies the measure for the Amount provided for Distance, Time, and Quantity Amounts. 
Some valid values for this element would include day, weeks, months.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="DeductibleCurrencyExchangeRate" type="xsd:decimal">
				<xsd:annotation>
          <xsd:documentation>This element is used in a calculation to convert deductible amounts from one currency to another currency.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DeductibleRate"
				type="xsd:decimal">
				<xsd:annotation>
          <xsd:documentation>This element contains the Rate that will be applied to determine the Deductible Amount.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DeductiblePercent"
				type="xsd:decimal">
				<xsd:annotation>
          <xsd:documentation>This element contains a percent of the total deductible.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="PremiumBasisAmount"
				type="xsd:decimal"><xsd:annotation><xsd:documentation>&lt;BR&gt;
&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;SPAN style='FONT-SIZE: 10pt; FONT-FAMILY: &quot;Arial&quot;,&quot;sans-serif&quot;'&gt;This element contains the amount&amp;nbsp;used as&amp;nbsp;the basis of the premium; it is used to calculate other financial amounts.&lt;?xml:namespace prefix = &quot;o&quot; ns = &quot;urn:schemas-microsoft-com:office:office&quot; /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;
&lt;br/&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" maxOccurs="unbounded"
				name="Customization" type="bons0:Customization">
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>