<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://ei/core/payroll_reporting_transaction"
	xmlns:bons1="http://ei/core/payroll_report"
	xmlns:bons0="http://ei/core/customizationx2">
	<xsd:import schemaLocation="CustomizationX2.xsd"
		namespace="http://ei/core/customizationx2">
	</xsd:import>
	<xsd:import namespace="http://ei/core/payroll_report"
		schemaLocation="PayrollReport.xsd" />
	<xsd:complexType name="PayrollReportingTransaction">
		<xsd:sequence>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="PayrollReport" type="bons1:PayrollReport">
			</xsd:element>
			<xsd:element minOccurs="0" name="Customization"
				type="bons0:Customization" maxOccurs="unbounded">
			</xsd:element>
			<xsd:element minOccurs="0" name="SourceSystemTransactionId"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the transaction id as it is known by the sourcre system.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="SourceSystemTransactionTypeName" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element is the name of the transaction type as it is called by the source system.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="PolicyNumber"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element identifies an insurance contract.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ContractNumber"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element identifies an insurance contract.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ControlNumber"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element is a unique identifier for each policy or submission.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="TransactionTimestamp"
				type="xsd:dateTime">
				<xsd:annotation>
          <xsd:documentation>&amp;nbsp;This element contains the timestamp of the transaction.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="TransactionEffectiveDate"
				type="xsd:date">
				<xsd:annotation>
          <xsd:documentation>This element is the date when changes made to information on a policy transaction are to take effect. This element is also
known as the Attaching Date and the ChangeEffectiveDate.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="InceptionDate"
				type="xsd:date">
				<xsd:annotation>
          <xsd:documentation>This element specifies the inception date of a policy term.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ExpirationDate"
				type="xsd:date">
				<xsd:annotation>
          <xsd:documentation>This element specifies the expiration date of a policy term.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0"
				name="PayRollReportingFrequencyCode" type="xsd:string">
				<xsd:annotation><xsd:documentation>&lt;br /&gt;
&lt;p&gt;
    This element contains a code that decsribes the frequency of the payroll report.
&lt;/p&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="BillingMethodCode"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element indicates if the policy should be billed to the Agent or direct billed to the Insured, Valid options for this
element are 'A' - Agent or 'D' - Direct Billed to the Insured.</xsd:documentation></xsd:annotation>
			</xsd:element>

		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>