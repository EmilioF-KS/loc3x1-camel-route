                            <wpc:script>
                              <wpc:javaCode><![CDATA[//There may be HazardousArea items already on the Reply from RAND.  Add to this array.

String countyName = GetUSMMIReply.getString("Location/StandardizedAddress/CountyName");
String encPostalCode = GetUSMMIReply.getString("Location/StandardizedAddress/EnclosingPostalCode");
GetLocationReply.setString("Location/StandardizedAddress/CountryName", countyName);
GetLocationReply.setString("Location/StandardizedAddress/EnclosingPostalCode", encPostalCode);
java.util.List mmiHazards = new java.util.ArrayList();

java.util.List hazards = GetUSMMIReply.getList("Location/HazardousArea");
java.util.Iterator it = hazards.iterator();
while (it.hasNext()){
	commonj.sdo.DataObject hazardBO = (commonj.sdo.DataObject)it.next();
	String hazardType = hazardBO.getString("HazardousAreaTypeName");
	if (IsWindRequested && hazardType.equalsIgnoreCase("Wind"))
		mmiHazards.add(hazardBO);
	if (IsEarthquakeRequested && hazardType.equalsIgnoreCase("Earthquake"))
		mmiHazards.add(hazardBO);
		}
		
GetLocationReply.getList("Location/HazardousArea").addAll(mmiHazards);]]></wpc:javaCode>
