<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://ei/core/individual_informationx2">
	<xsd:complexType name="IndividualInformation">
		<xsd:sequence>


			<xsd:element minOccurs="0" name="PrefixName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the prefix placed before a person's name.
Some valid options for this element include 'Mr.', 'Mrs.', 'Dr.'.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="GivenName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a person's first name.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="MiddleInitial"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the first letter from a person's middle name.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="Surname"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a person's last name.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="NameSuffix"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the suffix that follows a person’s full name and provides additional information about the person. There are academic, honorary, professional, and social name suffixes.
</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="IndividualBirthDate"
				type="xsd:date">
				<xsd:annotation>
          
        <xsd:documentation>This element contains the date the individual was born.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="SocialSecurityNumber"
				type="xsd:string">
				<xsd:annotation>
          
        <xsd:documentation>This element contains a person's federally issued social security number.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="IndividualsAge"
				type="xsd:int">
				<xsd:annotation>
          <xsd:documentation>This element contains a person's age.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="PrincipalIndicator"
				type="xsd:boolean">
				<xsd:annotation>
          <xsd:documentation>This element indicates if this is the principal individual.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="OccupationDescription"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a short description of an individual's occupation.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="OccupationDetailDescription" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a detailed description of an individual's occupation.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="MaritalStatusCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the code that identifies the marital status of an individual. Valid options for this element are:
'S'- Single, 'D' - Divorced, 'M'-Married, 'W'-Widowed, or spaces.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="MaritalStatusName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>&lt;br /&gt;
&lt;p&gt;
    This element contains the code that identifies the marital status of an individual.
&lt;/p&gt;</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="GenderCode"
				type="xsd:string"><xsd:annotation><xsd:documentation>&lt;p&gt;
    This element contains the code that identifies the&amp;nbsp;gender of an individual.
&lt;/p&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>