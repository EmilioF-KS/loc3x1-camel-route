<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
	targetNamespace="http://ei/core/policy_term_rule_based_status"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:complexType name="PolicyTermRuleBasedStatus">
		<xsd:sequence>
			<xsd:element minOccurs="0"
				name="PolicyTermRuleBasedStatusCode" type="xsd:string">
				<xsd:annotation><xsd:documentation>This element contains a code that identifies which Policy Terms should be returned.   Using Offering Status and a set of business rules, the Policy Terms are classified into a new derived status.   
These statuses currently include, but are not limited to Active and Future.
</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="AsOfDate"
				type="xsd:date">
				<xsd:annotation><xsd:documentation>This element contains the search start date.</xsd:documentation></xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>