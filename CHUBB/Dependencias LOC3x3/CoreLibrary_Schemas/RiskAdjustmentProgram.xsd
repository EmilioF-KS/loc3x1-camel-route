<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://ei/core/risk_adjustment_program">
	<xsd:complexType name="RiskAdjustmentProgram">
		<xsd:sequence>
			<xsd:element minOccurs="0" name="RiskAdjustmentProgramName"
				type="xsd:string"><xsd:annotation><xsd:documentation>&lt;br /&gt;
&lt;p&gt;
    This element contains the name of a risk adjustment program.
&lt;/p&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="RiskAdjustmentProgramFactor" type="xsd:string"><xsd:annotation><xsd:documentation>&lt;br /&gt;
&lt;p&gt;
    This element contains the factor associated with a particular risk adjustment program.
&lt;/p&gt;</xsd:documentation></xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>