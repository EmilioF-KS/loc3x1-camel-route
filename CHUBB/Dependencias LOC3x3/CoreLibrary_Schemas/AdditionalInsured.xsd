<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://ei/core/additional_insured"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:bons3="http://ei/core/typed_addressx3"
	xmlns:bons2="http://ei/core/business_party_covered_risk_interest"
	xmlns:bons0="http://ei/core/business_party_characteristic">
	<xsd:import schemaLocation="BusinessPartyCharacteristic.xsd"
		namespace="http://ei/core/business_party_characteristic">
	</xsd:import>
	<xsd:import schemaLocation="BusinessPartyCoveredRiskInterest.xsd"
		namespace="http://ei/core/business_party_covered_risk_interest">
	</xsd:import>
	<xsd:import schemaLocation="TypedAddressX3.xsd"
		namespace="http://ei/core/typed_addressx3">
	</xsd:import>


	<xsd:complexType name="AdditionalInsured">
		<xsd:sequence>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="BusinessPartyCoveredRiskInterest"
				type="bons2:BusinessPartyCoveredRiskInterest">
			</xsd:element>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="BusinessPartyCharacteristic"
				type="bons0:BusinessPartyCharacteristic">
			</xsd:element>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="TypedAddress" type="bons3:TypedAddress">
			</xsd:element>
			<xsd:element minOccurs="0"
				name="AdditionalInsuredSequenceNumber" type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This elements contains a sequential number that is incremented each time a new additional Insured is added.    

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="AdditionalInsuredName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the name of the Additional Insured.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>

			<xsd:element minOccurs="0" name="EnterpriseBPRoleCode"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains a code that represents the function or position a specific business party may play on a Policy or Service Offering for a given enterprise.
The E1T01611 Corporate Table contains valid values for this element in the "ENTRP_BP_ROLE_C" column. 


</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="EnterpriseBPRoleName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the function or position a specific business party may play on a Policy or Service Offering for a given enterprise.
The E1T01611 Corporate Table contains valid values for this element in the "ENTRP_BP_ROLE_NA" column. </xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="BPEntityTypeName"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element identifies the legal nature of the business party. (i.e., individual or organization).</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="LoanNumber"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains the number that identifies a loan.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="PolicyCopyIndicator"
				type="xsd:boolean">
				<xsd:annotation>
          <xsd:documentation>This element indicates if a copy of the Policy is to be sent to a Business Party.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0"
				name="AdditionalInsuredOFACRequestedDate" type="xsd:date">
				<xsd:annotation>
          <xsd:documentation>This is the date when the Office of Foreign Assets Control search was requested for the Additional Insured.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="MessageAdditionalInsuredId"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains an Id assigned for the  lifetime of the message that will be used to identify the Additional Interest.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="OccupantIndicator"
				type="xsd:boolean">
				<xsd:annotation>
          <xsd:documentation>This element indicates if the additional interested party resides at this location.

</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="RelativeIndicator"
				type="xsd:boolean">
				<xsd:annotation>
          <xsd:documentation>This element indicates if the additonal interested party related to the Insured.</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="DescriptionOfInterestText"
				type="xsd:string">
				<xsd:annotation>
          <xsd:documentation>This element contains an area of text used to describe the additional Insured's connection to the property.


</xsd:documentation>
        </xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>