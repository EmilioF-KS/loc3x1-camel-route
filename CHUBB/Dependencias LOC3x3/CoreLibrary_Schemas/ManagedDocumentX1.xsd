<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://ei/core/managed_documentx1"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:bons0="http://ei/core/document_indexing_group"
	xmlns:bons1="http://ei/core/file">
	<xsd:import schemaLocation="File.xsd"
		namespace="http://ei/core/file">
	</xsd:import>
	<xsd:import schemaLocation="DocumentIndexingGroup.xsd"
		namespace="http://ei/core/document_indexing_group">
	</xsd:import>
	<xsd:complexType name="ManagedDocument">
		<xsd:complexContent>
			<xsd:extension base="bons1:File">
				<xsd:sequence>
					<xsd:element minOccurs="0" maxOccurs="unbounded"
						name="DocumentIndexingGroup" type="bons0:DocumentIndexingGroup">
					</xsd:element>
					<xsd:element minOccurs="0"
						name="DocumentDescription" type="xsd:string"><xsd:annotation><xsd:documentation>This element contains a description of the document.</xsd:documentation></xsd:annotation>
					</xsd:element>
					<xsd:element minOccurs="0"
						name="DocumentContentBusinessEffectiveDate" type="xsd:date"><xsd:annotation><xsd:documentation>This element represents the business date associated with the document.   </xsd:documentation></xsd:annotation>
					</xsd:element>
					<xsd:element minOccurs="0"
						name="DocumentReplacementIndicator" type="xsd:boolean"><xsd:annotation><xsd:documentation>This element specifies whether the document should be replaced in the repository.</xsd:documentation></xsd:annotation>
					</xsd:element>
					<xsd:element minOccurs="0"
						name="DocumentBusinessTypeDescription" type="xsd:string"><xsd:annotation><xsd:documentation>This element contains a description of the type of business document.</xsd:documentation></xsd:annotation>
					</xsd:element>
					<xsd:element minOccurs="0"
						name="DocumentBusinessVersionNumber" type="xsd:string"><xsd:annotation><xsd:documentation>This element contains the business version number of the document.</xsd:documentation></xsd:annotation>
					</xsd:element>
					<xsd:element minOccurs="0"
						name="PrimaryDocumentIndicator" type="xsd:boolean"><xsd:annotation><xsd:documentation>This element indicates if this is the primary document. it is used when there are many documents to flag.</xsd:documentation></xsd:annotation>
					</xsd:element>
					<xsd:element minOccurs="0"
						name="DocumentBusinessTypeCode" type="xsd:string"><xsd:annotation><xsd:documentation>This element contains a code of the type of business document.</xsd:documentation></xsd:annotation>
					</xsd:element>
					<xsd:element minOccurs="0"
						name="DocumentCreationDate" type="xsd:date"><xsd:annotation><xsd:documentation>This element specifies the date the document was created.</xsd:documentation></xsd:annotation>
					</xsd:element>
				</xsd:sequence>

			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
</xsd:schema>