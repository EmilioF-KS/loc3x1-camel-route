<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://ei/core/alliance_market_segment"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:complexType name="AllianceMarketSegment">
		<xsd:sequence>
			<xsd:element name="AllianceMarketSegmentCode"
				type="xsd:string" nillable="true" minOccurs="0">
				<xsd:annotation>
						<xsd:documentation>This element contains a value that uniquely identifies an Alliance specific market segment.</xsd:documentation>
					</xsd:annotation>
			</xsd:element>
			<xsd:element name="AllianceMarketSegmentName"
				type="xsd:string" nillable="true" minOccurs="0">
				<xsd:annotation>
						
					<xsd:documentation>This element contains the name associated with Alliance market segment code.</xsd:documentation></xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>