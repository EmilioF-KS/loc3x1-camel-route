# Root .gitignore for camel-route

# Python
__pycache__/
*.py[cod]
*$py.class
.env
.venv
env/
venv/
ENV/
.env.local
.pytest_cache/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.pyre/
.pytype/

# macOS
.DS_Store

# IDE/editor
.vscode/
.idea/

# Build outputs (Java/Maven/Gradle)
**/target/
**/build/
loc3x1-camel-route/libs/

# Node (if introduced later)
node_modules/

# Coverage / reports (keep tests/results, ignore temp caches)
.coverage
.coverage.*
*.cover
*.py,cover

# Binary / generated artefacts not source-controlled
site/

# Logs (keep agent evidence under doc/)
*.log

# Runtime outputs (generated during runs)
uploads/
tests/results/
ci/artifacts/
frontend/dist/
results/agent-runs/