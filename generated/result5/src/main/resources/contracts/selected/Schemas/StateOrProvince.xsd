<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://ei/core/state_or_province"
	elementFormDefault="qualified">
	<xsd:complexType name="StateOrProvince">
		<xsd:sequence>
			<xsd:element minOccurs="0" name="StateOrProvinceCode" type="xsd:string"/>
			<xsd:element minOccurs="0" name="StateOrProvinceAbbreviation" type="xsd:string"/>
			<xsd:element minOccurs="0" name="StateOrProvinceName" type="xsd:string"/>
			<xsd:element minOccurs="0" name="PostalStateAbbreviation" type="xsd:string"/>
			<xsd:element minOccurs="0" name="CountryCode" type="xsd:string"/>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
