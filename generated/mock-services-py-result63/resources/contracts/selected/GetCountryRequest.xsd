<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://ei/corporate/get_country_request_crp10x1">
	<xsd:complexType name="GetCountryRequest">
		<xsd:sequence>			<xsd:element minOccurs="0" name="CountryCode"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element is a code for a country, nation or political state.
The E1T00101 Corporate Table contains valid values for this element in the &quot;CNTRY_C&quot; column. </xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ISOCountryCode"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element is the abbreviation used by the International Standards Organization (ISO) that identifies a country, nation or political state.
The E1T00101 Corporate Table contains valid values for this element in the &quot;ISO_CNTRY_C&quot; column. </xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="ConvertedISOCountryCode"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element is a legacy Chubb code for a country, nation or political state.
The E1T00101 Corporate Table contains valid values for this element in the &quot;CONV_ISO_CNTRY_C&quot; column. </xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="CountryAbbreviation"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element is the abbreviation for a country, nation or political state.
The E1T00101 Corporate Table contains valid values for this element in the &quot;CNTRY_AB&quot; column. </xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="CountryName"
				type="xsd:string">
				<xsd:annotation><xsd:documentation>This element is the name for a country, nation or political state.
The E1T00101 Corporate Table contains valid values for this element in the &quot;CNTRY_NA&quot; column. </xsd:documentation></xsd:annotation>
			</xsd:element>
			<xsd:element minOccurs="0" name="AsOfDate"
				type="xsd:date"><xsd:annotation><xsd:documentation>This element contains the search start date.</xsd:documentation></xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
